# Salin menjadi .env.local untuk pengembangan lokal.
# Jangan pernah mengisi key asli di file yang masuk Git.
# Tutor dan TTS harus tetap memiliki fallback lokal ketika variabel ini kosong.

GEMINI_API_KEY=
GEMINI_TUTOR_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Aoede
TUTOR_ENABLED=true
