# Salin menjadi .env.local untuk pengembangan lokal.
# Jangan pernah mengisi key asli di file yang masuk Git.
# Tutor harus tetap memiliki fallback ketika variabel ini kosong.
GEMINI_API_KEY=
# Tentukan model yang tersedia untuk akun/proyek saat implementasi.
# Periksa model dan free-tier limits terkini melalui Google AI Studio/docs.
GEMINI_MODEL=
# Optional feature flag; default false sampai endpoint diuji.
TUTOR_ENABLED=false
